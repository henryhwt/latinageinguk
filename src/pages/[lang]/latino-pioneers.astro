---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/sections/PageHeader.astro";
import Button from "../../components/ui/Button.astro";

import { LOCALES, useTranslations, type Lang } from "../../i18n";

const t = useTranslations(Astro.currentLocale as Lang);
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale as Lang;

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));

const youtubeUrl = "https://www.youtube.com/watch?v=jdgv8kGNedw";
const encodedUrl = encodeURIComponent(youtubeUrl);
const shareText = encodeURIComponent(
  "Watch Latino Pioneers — a documentary about Latin American immigrants in the UK in the 1970s"
);
---

<BaseLayout
  title="Latino Pioneers - Latin Ageing UK"
  description="Latino Pioneers is a short documentary film directed by Alexander P.C. exploring the struggles and successes of Latin American immigrants who arrived in the UK in the 1970s."
>
  <PageHeader
    title={t({ en: "Latino Pioneers", es: "Latino Pioneers" })}
    subtitle={t({
      en: "A Documentary Film by Alexander P.C.",
      es: "Un documental de Alexander P.C.",
    })}
    backgroundImage="/lp-4.png"
  />

  <!-- About the Film -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">
            {t({ en: "About the Film", es: "Sobre el documental" })}
          </h2>
          <p class="text-xl text-gray-700 mb-6">
            {
              t({
                en: "Latino Pioneers is a short documentary film directed by Bolivian and London-based filmmaker Alexander P. C. whose work brings the untold stories of the Latin American diaspora to the screen.",
                es: "Latino Pioneers es un cortometraje documental dirigido por Alexander P.C., un cineasta boliviano afincado en Londres cuyo trabajo da voz a las historias no contadas de la diáspora latinoamericana.",
              })
            }
          </p>
          <p class="text-xl text-gray-700 mb-6">
            {
              t({
                en: "The film takes us back to the 1970s, through intimate interviews with Latin American immigrants who arrived in the United Kingdom during that decade. Their stories are ones of courage and resilience, detailing the struggles of building a new life in a foreign land, alongside the remarkable successes they achieved in the face of adversity.",
                es: "El documental nos lleva a los años 70 a través de entrevistas íntimas con inmigrantes latinoamericanos que llegaron al Reino Unido durante esa década. Sus historias son de valentía y resiliencia: las dificultades de construir una nueva vida en tierra extraña, junto a los logros extraordinarios que alcanzaron frente a la adversidad.",
              })
            }
          </p>
          <p class="text-xl text-gray-700 mb-8">
            {
              t({
                en: "Latino Pioneers is a tribute to those who came before us, for those who carved out a place for the Latin American community in Britain, and whose sacrifices paved the way for generations to come.",
                es: "Latino Pioneers es un tributo a quienes llegaron antes que nosotros, personas que abrieron un camino para la comunidad latinoamericana en Gran Bretaña y cuyos sacrificios allanaron el camino a las generaciones siguientes.",
              })
            }
          </p>
          <Button href={youtubeUrl} variant="primary" size="lg" target="_blank">
            {t({ en: "Watch the Documentary", es: "Ver el documental" })}
          </Button>
        </div>

        <div class="flex justify-center">
          <img
            src="/lp-1.png"
            alt="Latino Pioneers card"
            class="rounded-lg shadow-lg object-cover w-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Key Themes -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          {t({ en: "Stories of a Generation", es: "Las historias de una generación" })}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {
            t({
              en: "Through the voices of those who lived it, Latino Pioneers explores what it meant to leave home and build a new life in Britain.",
              es: "A través de las voces de quienes lo vivieron, Latino Pioneers explora lo que significó dejar el hogar y construir una nueva vida en Gran Bretaña.",
            })
          }
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-lg shadow-sm flex flex-col items-center">
          <div
            class="w-20 h-20 mx-auto mb-4 rounded-full bg-secondary-100 flex items-center justify-center text-7xl"
          >
            <i class="material-icons">diversity_1</i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-center">
            {t({ en: "The Pioneers", es: "Los pioneros" })}
          </h3>
          <p class="text-gray-700 text-center">
            {
              t({
                en: "Meet the remarkable individuals who made the journey from Latin America to the UK in the 1970s, and hear their stories in their own words.",
                es: "Conoce a las personas extraordinarias que hicieron el viaje desde América Latina al Reino Unido en los años 70 y escucha sus historias en sus propias palabras.",
              })
            }
          </p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-sm flex flex-col items-center">
          <div
            class="w-20 h-20 mx-auto mb-4 rounded-full bg-secondary-100 flex items-center justify-center text-7xl"
          >
            <i class="material-icons">hiking</i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-center">
            {t({ en: "Struggles and Barriers", es: "Obstáculos y dificultades" })}
          </h3>
          <p class="text-gray-700 text-center">
            {
              t({
                en: "From language barriers to discrimination, the documentary honestly portrays the hardships faced by Latin Americans seeking a better life in Britain.",
                es: "Desde las barreras del idioma hasta la discriminación, el documental retrata con honestidad las dificultades que enfrentaron los latinoamericanos en busca de una vida mejor en Gran Bretaña.",
              })
            }
          </p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-sm flex flex-col items-center">
          <div
            class="w-20 h-20 mx-auto mb-4 rounded-full bg-secondary-100 flex items-center justify-center text-7xl"
          >
            <i class="material-icons">stars</i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-center">
            {t({ en: "Triumph and Legacy", es: "Triunfo y legado" })}
          </h3>
          <p class="text-gray-700 text-center">
            {
              t({
                en: "Discover the successes, achievements, and lasting contributions of these pioneers to British society and to the Latin American community in the UK.",
                es: "Descubre los éxitos, logros y contribuciones duraderas de estos pioneros a la sociedad británica y a la comunidad latinoamericana en el Reino Unido.",
              })
            }
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Watch & Share CTA -->
  <section
    class="py-20 bg-cover bg-center bg-white text-gray-700"
  >
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          {t({ en: "Watch the Documentary", es: "Ver el documental" })}
        </h2>
        <p class="text-xl mb-8">
          {
            t({
              en: "Watch the full documentary on YouTube and share it with your friends and family. Help us spread the word about this important piece of Latin American history in Britain.",
              es: "Mira el documental completo en YouTube y compártelo con tus amigos y familiares. Ayúdanos a difundir esta importante página de la historia latinoamericana en Gran Bretaña.",
            })
          }
        </p>

        <div class="flex flex-wrap justify-center gap-4 mb-10">
          <Button href={youtubeUrl} variant="primary" size="lg" target="_blank">
            {t({ en: "Watch on YouTube", es: "Ver en YouTube" })}
          </Button>
        </div>

        <p class="text-lg mb-5">
          {t({ en: "Share this documentary:", es: "Comparte este documental:" })}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors border-2 border-blue-600 hover:border-blue-700"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            {t({ en: "Share on Facebook", es: "Compartir en Facebook" })}
          </a>

          <a
            href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${shareText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 hover:bg-black text-white rounded-lg font-medium transition-colors border-2 border-gray-700 hover:border-black"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 16 16">
              <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/>
            </svg>
            {t({ en: "Share on X", es: "Compartir en X" })}
          </a>

          <a
            href={`https://wa.me/?text=${shareText}%20${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-green-500 hover:bg-green-600 text-white rounded-lg font-medium transition-colors border-2 border-green-500 hover:border-green-600"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {t({ en: "Share on WhatsApp", es: "Compartir en WhatsApp" })}
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- Share Your Story -->
  <section
    class="py-20 bg-cover bg-center text-white"
    style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url(/uploads/hero/dance-yellow.jpg)"
  >
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white">
          {t({ en: "Do You Have a Story to Share?", es: "¿Tienes una historia que contar?" })}
        </h2>
        <p class="text-xl mb-8">
          {
            t({
              en: "Are you, or is someone you know, a Latin American pioneer? Every story matters. If you have a memory, a journey, or an experience you'd like to share, we'd love to hear from you. Message us on social media and let's make sure your voice is heard.",
              es: "¿Eres tú, o alguien a quien conoces, un pionero latinoamericano que llegó al Reino Unido en los años 70, o en cualquier otra época? Cada historia importa. Si tienes un recuerdo, un viaje o una experiencia que quieras compartir, nos encantaría escucharte. Escríbenos a través de las redes sociales y asegurémonos de que tu voz sea escuchada.",
            })
          }
        </p>
        <Button
          href="https://www.facebook.com/profile.php?id=100090506665209"
          variant="primary"
          size="lg"
          target="_blank"
        >
          {t({ en: "Get in touch", es: "Ponte en contacto con nosotros" })}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
