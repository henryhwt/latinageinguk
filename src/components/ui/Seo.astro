---
import { DEFAULT_LOCALE, LOCALES, type Lang } from "../../i18n";

export interface Props {
  title: string;
  description: string;
  image?: {
    url: string;
    alt: string;
  };
  type?: "website" | "article";
  canonicalUrl?: string;
  lang?: Lang;
}

const {
  title,
  description,
  image = {
    url: "/uploads/hero/group.jpg",
    alt: "Latin Ageing UK community members",
  },
  type = "website",
  canonicalUrl,
  lang = DEFAULT_LOCALE,
} = Astro.props;

const canonicalURL = canonicalUrl || new URL(Astro.url.pathname, Astro.site);

// Map locale codes to OG locale format
const ogLocaleMap: Record<string, string> = {
  en: "en_US",
  es: "es_ES",
};
const ogLocale = ogLocaleMap[lang] ?? lang;
const inLanguage = LOCALES[lang]?.lang ?? lang;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "Latin Ageing UK",
  alternateName: "Latin Ageing UK CIC",
  description:
    "Latin Ageing UK empowers people aged 50+ from Latin American and Spanish-speaking communities in the London Borough of Southwark.",
  url: "https://latinageinguk.co.uk",
  logo: new URL("/uploads/favicon/apple-touch-icon.png", Astro.site).toString(),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Southwark",
    addressRegion: "London",
    addressCountry: "GB",
  },
  inLanguage,
  sameAs: [
    "https://www.facebook.com/profile.php?id=100090506665209",
  ],
};
---

<!-- Basic SEO -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.url, Astro.site)} />
<meta property="og:image:alt" content={image.alt} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content="Latin Ageing UK" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image.url, Astro.site)} />
<meta name="twitter:image:alt" content={image.alt} />

<!-- JSON-LD: Organisation -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

{
  type === "article" && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        inLanguage,
        image: new URL(image.url, Astro.site).toString(),
        description: description,
        publisher: {
          "@type": "Organization",
          name: "Latin Ageing UK",
          logo: {
            "@type": "ImageObject",
            url: new URL("/uploads/favicon/apple-touch-icon.png", Astro.site).toString(),
          },
        },
        url: canonicalURL.toString(),
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalURL.toString(),
        },
      })}
    />
  )
}
